# Enable rewrite engine
RewriteEngine On

# Rewrite sitemap.xml to sitemap.php
RewriteRule ^sitemap\.xml$ sitemap.php [QSA,L]

# ────────────────────────────────────────────────────────────────────────────
# SECURITY HEADERS
# ────────────────────────────────────────────────────────────────────────────

# Prevent MIME type sniffing
Header set X-Content-Type-Options "nosniff"

# Prevent clickjacking attacks
Header set X-Frame-Options "DENY"

# Legacy XSS protection
Header set X-XSS-Protection "1; mode=block"

# Referrer policy - don't send referrer to cross-origin requests
Header set Referrer-Policy "strict-origin-when-cross-origin"

# HSTS - Enforce HTTPS for 1 year
Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

# Content Security Policy - restrict resource loading
Header set Content-Security-Policy "default-src 'self'; script-src 'self' https://8x8.vc https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://api.openai.com https://api.anthropic.com https://*.supabase.co; frame-src 'self' https://8x8.vc"

# Permissions policy - restrict browser features
Header set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

# ────────────────────────────────────────────────────────────────────────────
# DISABLE DEBUG FILES & SOURCE CODE
# ────────────────────────────────────────────────────────────────────────────

# Deny access to debug/config files
#
# "Deny from all" is Apache 2.2 syntax. On Apache 2.4 it is silently
# ignored unless the legacy mod_access_compat module is loaded, which
# many modern hosts (incl. shared hosting) don't load by default -
# the block below then does nothing and the file is served normally.
# Every rule here sets both the 2.4 ("Require all denied") and 2.2
# ("Deny from all") directive, guarded so only the one the running
# Apache understands is active.
<Files "check_hash.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</Files>

<Files "db_config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</Files>

# Block all Python files from being served
<FilesMatch "\.py$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Block environment and config files
<FilesMatch "(^|/)\.env$|\.(env|example|local)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Block source control and build files
<FilesMatch "\.(git|gitignore|md|json|lock)$|^(composer\.|package\.|webpack\.|tsconfig\.)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Block common backup/temp files
<FilesMatch "\.(bak|tmp|swp|swo|~)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# ────────────────────────────────────────────────────────────────────────────
# PREVENT DIRECTORY LISTING
# ────────────────────────────────────────────────────────────────────────────

Options -Indexes

# ────────────────────────────────────────────────────────────────────────────
# DISABLE DANGEROUS PHP FEATURES
# ────────────────────────────────────────────────────────────────────────────

<IfModule mod_php.c>
    php_flag display_errors Off
    php_flag log_errors On
    php_value error_log /var/log/php-errors.log

    # Disable dangerous functions
    php_value disable_functions "exec,passthru,shell_exec,system,proc_open,popen,curl_exec,curl_multi_exec,parse_ini_file,show_source"
</IfModule>
